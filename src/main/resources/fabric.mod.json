{
  "schemaVersion": 1,
  "id": "voolkan",
  "provides": ["vulkanmod"],
  "version": "${version}",

  "name": "voolkan",
  "description": "Unofficial fork of VulkanMod: Vulkan renderer for Minecraft, with a legacy render pass path for GPUs without VK_KHR_dynamic_rendering.",
  "authors": [
    "Collateral",
    "voolkan project"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/rvyyv-n/voolkan"
  },

  "license": ["LGPL-3.0-only"],

  "icon": "assets/vulkanmod/voolkan_icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vulkanmod.Initializer"
    ]
  },
  "mixins": [
    "vulkanmod.mixins.json"
  ],
  "accessWidener" : "vulkanmod.accesswidener",

  "depends": {
    "fabricloader": ">=0.14.14",
    "minecraft": "1.21.11"
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  }
}
